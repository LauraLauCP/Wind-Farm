# Copy this file to `.env` and fill in your own AEMET API key.
# Get a free key at https://opendata.aemet.es/centrodedescargas/inicio
# (use a personal e-mail account — corporate accounts are blocked).
# NOTE: since July 2026 AEMET expires new keys after 3 months; renew and
# update this value when upstream answers 401/502 aemet_invalid_api_key.

AEMET_API_KEY=your-aemet-api-key-here

# Optional: port the API listens on (default 3000)
PORT=3000

# Optional: SQLite cache location (default ./data/windfarm.sqlite, git-ignored)
DB_PATH=./data/windfarm.sqlite

# Optional: pino log level — trace | debug | info | warn | error (default info)
LOG_LEVEL=info

# Optional: max concurrent requests to the AEMET API (default 3)
AEMET_MAX_CONCURRENT=3
