{
  "name": "wind-farm-api",
  "version": "0.1.0",
  "description": "Web API + front-end to retrieve AEMET meteorological data for wind farm feasibility studies (GS Inima challenge, Parts 1-3)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm run dev\" \"npm --prefix frontend run dev\"",
    "build": "tsc",
    "build:all": "npm run build && npm --prefix frontend run build",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:all": "npm test && npm --prefix frontend test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "luxon": "^3.7.2",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
